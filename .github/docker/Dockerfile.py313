ARG BASE_IMAGE=nvidia/cuda:13.0.0-devel-ubuntu22.04@sha256:1470d2d7904fac4e5cb3bdfd4993305c46d3ee76deb0213eaaf248e5cf9c7400
FROM ${BASE_IMAGE}

ARG TORCH_VERSION=2.13.0
ARG PYTHON_VERSION=3.13
ARG CUDA_INDEX_URL=https://download.pytorch.org/whl/cu130

ENV DEBIAN_FRONTEND=noninteractive

COPY .github/docker/requirements-builder.txt /tmp/requirements-builder.txt

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       software-properties-common ca-certificates curl git build-essential \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
       python${PYTHON_VERSION} python${PYTHON_VERSION}-dev \
       python${PYTHON_VERSION}-venv \
    && python${PYTHON_VERSION} -m venv /opt/sage-py313 \
    && /opt/sage-py313/bin/python -m pip install --no-cache-dir \
       --require-hashes --requirement /tmp/requirements-builder.txt \
    && /opt/sage-py313/bin/python -m pip install --no-cache-dir \
       --index-url "${CUDA_INDEX_URL}" \
       "torch==${TORCH_VERSION}" \
    && rm -rf /var/lib/apt/lists/*

ENV PATH=/opt/sage-py313/bin:${PATH}

LABEL io.github.le0nzheng123.sage-wheels-builder="true"

WORKDIR /workspace
